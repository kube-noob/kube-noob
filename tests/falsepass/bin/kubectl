#!/usr/bin/env python3
"""A kubectl that answers from files, for the live cases of the false-pass benchmark.

``$FALSEPASS_KUBECTL`` names a scenario directory. For ``kubectl get <resource>[.group] [name] [--namespace ns]``
the resource's plural (the part before the first dot) picks the answer, most specific file first:
``<plural>.<name>--<ns>``, ``<plural>.<name>``, ``<plural>--<ns>``, ``<plural>``, then ``default``, each as
``<key>.json`` (stdout), ``<key>.stderr`` and ``<key>.exit``; a missing exit file is 0, a missing stdout file is
empty. ``kubectl version`` reads ``version.*`` the same way. Nothing else is read, nothing is written, and no
network exists: this is the cluster's answer as a reviewer wrote it down.
"""

import os
import sys
from pathlib import Path


def main() -> int:
    scenario = os.environ.get("FALSEPASS_KUBECTL")
    if not scenario:
        sys.stderr.write("stub kubectl: FALSEPASS_KUBECTL is not set\n")
        return 70
    base = Path(scenario)
    args = sys.argv[1:]
    keys = ["default"]
    if len(args) >= 2 and args[0] == "get":
        plural = args[1].split(".", 1)[0]
        name = args[2] if len(args) > 2 and not args[2].startswith("-") else ""
        ns = ""
        for i, arg in enumerate(args):
            if arg in ("--namespace", "-n") and i + 1 < len(args):
                ns = args[i + 1]
        keys = []
        if name and ns:
            keys.append(f"{plural}.{name}--{ns}")
        if name:
            keys.append(f"{plural}.{name}")
        if ns:
            keys.append(f"{plural}--{ns}")
        keys += [plural, "default"]
    elif args and args[0] == "version":
        keys = ["version", "default"]
    for name in keys:
        out, err, code = base / f"{name}.json", base / f"{name}.stderr", base / f"{name}.exit"
        if out.is_file() or err.is_file() or code.is_file():
            if out.is_file():
                sys.stdout.write(out.read_text("utf-8"))
            if err.is_file():
                sys.stderr.write(err.read_text("utf-8"))
            return int(code.read_text("utf-8").strip()) if code.is_file() else 0
    sys.stderr.write(f"stub kubectl: no answer for {' '.join(args[:3])}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
